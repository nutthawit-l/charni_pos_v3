{
  "languages": {
    "Python": {
      "language_servers": [
        "!basedpyright",
        "!pyright",
        "ruff"
      ]
    }
  },
  "terminal": {
    "detect_venv": {
      "on": {
        "directories": [".venv"],
        "activate_script": "default"
      }
    }
  },
  "vim.handleKeys": {
    "<C-b>": false
  }
}
